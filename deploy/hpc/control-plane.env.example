# Copy to WORKFLOW_RUNTIME_DIR/config/control-plane.env and edit for your site.
# Raw NAME=VALUE format: no export, quotes, or shell variable substitutions.
WorkFlow_DASK_SCHEDULER_HOST=service.cluster.example
WorkFlow_DASK_SCHEDULER_PORT=8786
WorkFlow_DASK_WORKER_PORT_RANGE=20000:20999
WorkFlow_DASK_NANNY_PORT_RANGE=21000:21999
WorkFlow_DASK_DASHBOARD_ADDRESS=127.0.0.1:8787
WorkFlow_DASHBOARD_HOST=127.0.0.1:18787
# Choose only partitions your account can use and whose GPUs you have tested.
WorkFlow_SLURM_ALLOWED_PARTITIONS=cpu,gpu
WorkFlow_SLURM_EXCLUDED_PARTITIONS=
WorkFlow_SLURM_EXCLUDED_NODES=
# Leave blank only if your site supplies suitable defaults.
WorkFlow_SLURM_ACCOUNT=
WorkFlow_SLURM_QOS=
WorkFlow_SLURM_RESERVATION=
WorkFlow_SLURM_SRUN=srun
# Absolute shared Bash script for module loading and site environment, if needed.
WorkFlow_SLURM_WORKER_SETUP=
WorkFlow_SLURM_TIME_LIMIT=1-00:00:00
WorkFlow_SLURM_QUEUE_START_TIMEOUT_SECONDS=0
# Application ceilings; adjust to your approved allocation, not just node count.
WorkFlow_SLURM_MAX_NODES=8
WorkFlow_SLURM_MAX_CPUS=256
WorkFlow_SLURM_MAX_GPUS=8
WorkFlow_SLURM_MAX_MEMORY_GIB=768
WorkFlow_SLURM_CPUS_PER_NODE=64
WorkFlow_SLURM_GPUS_PER_NODE=8
WorkFlow_SLURM_MEMORY_GIB_PER_NODE=512
# Configure all three TLS files, or explicitly opt into trusted-network testing.
WorkFlow_DASK_TLS_CA=/shared/private/dask-ca.pem
WorkFlow_DASK_TLS_CERT=/shared/private/dask-service.pem
WorkFlow_DASK_TLS_KEY=/shared/private/dask-service.key
WorkFlow_DASK_ALLOW_INSECURE_CLUSTER=0
